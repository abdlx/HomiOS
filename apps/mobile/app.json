{
  "expo": {
    "name": "HomiFiles",
    "slug": "homifiles",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "homifiles",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homios.homifiles",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "homifiles"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.homios.homifiles",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "video/*"
            },
            {
              "mimeType": "audio/*"
            },
            {
              "mimeType": "application/*"
            },
            {
              "mimeType": "text/*"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "video/*"
            },
            {
              "mimeType": "audio/*"
            },
            {
              "mimeType": "application/*"
            },
            {
              "mimeType": "text/*"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      "expo-image-picker"
    ]
  }
}
