{
  "expo": {
    "name": "OpenFinder Files",
    "slug": "openfinder-files",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "openfinder-files",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openfinder.files"
    },
    "android": {
      "package": "com.openfinder.files",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      "expo-image-picker"
    ]
  }
}
