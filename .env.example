# OpenFinder Environment Variables

# Admin login for the Web UI (env-based login; a real DB session is created on use)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Optional: SQLite database path (defaults to ./data/filemanager.db)
# DATABASE_URL=./data/filemanager.db

# ── Deployment engine (Docker Manager) ───────────────────────────────────────
# Set an email to enable automatic Let's Encrypt HTTPS via the Traefik proxy.
# When set, the proxy adds a websecure (:443) router + cert resolver and
# redirects HTTP→HTTPS. Leave empty to serve apps over plain HTTP only.
# ACME_EMAIL=you@example.com

# Host ports the reverse proxy binds. Defaults to 80/443. Override if those are
# already taken (e.g. by the OpenFinder UI's own nginx) — e.g. 8080/8443.
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443

# Optional: path to the docker binary if not on PATH.
# DOCKER_BIN=docker
