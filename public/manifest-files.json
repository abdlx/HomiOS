{
  "name": "OpenFinder Files",
  "short_name": "Files",
  "description": "Manage your files from anywhere",
  "start_url": "/files?pwa=files",
  "id": "/files",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#0A84FF",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "OpenFinder Files App"
    }
  ],
  "share_target": {
    "action": "/api/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "video/*", "application/pdf", "*/*"]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Upload File",
      "short_name": "Upload",
      "description": "Upload a file to your storage",
      "url": "/files?action=upload&pwa=files",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Recent Files",
      "short_name": "Recent",
      "description": "View recently accessed files",
      "url": "/files?view=recent&pwa=files",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
