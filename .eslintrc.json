{
  "root": true,
  "extends": "next/core-web-vitals",
  "ignorePatterns": [
    "coolify/**",
    "apps/mobile/**",
    "data/**",
    "data_mock/**",
    "public/**",
    ".next/**",
    "node_modules/**",
    "scripts/**"
  ],
  "rules": {
    "@next/next/no-img-element": "off",
    "react/no-unescaped-entities": "off",
    "react-hooks/exhaustive-deps": "warn"
  }
}
